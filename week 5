
#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>
using namespace std;

int main() {
    // 1D ARRAY: WEEKLY REVENUE
    double revenue[7];
    double totalRevenue = 0;
    double averageRevenue;

    string days[7] = {
        "Monday", "Tuesday", "Wednesday",
        "Thursday", "Friday", "Saturday", "Sunday"
    };

    cout << "===== WEEKLY REVENUE TRACKER =====\n";

    for (int i = 0; i < 7; i++) {
        cout << "Enter revenue for " << days[i] << ": KSh ";
        cin >> revenue[i];

        totalRevenue += revenue[i];
    }

    averageRevenue = totalRevenue / 7.0;

    cout << fixed << setprecision(2);
    cout << "\nTotal Weekly Revenue: KSh "
         << totalRevenue << endl;
    cout << "Average Daily Revenue: KSh "
         << averageRevenue << endl;

    // 2D ARRAY: ROOM OCCUPANCY FOR ONE BRANCH
    int occupancy[5][10];
    int occupied, vacant;

    srand(static_cast<unsigned int>(time(0)));

    cout << "\n===== ONE BRANCH ROOM OCCUPANCY =====\n";

    for (int floor = 0; floor < 5; floor++) {
        occupied = 0;

        for (int room = 0; room < 10; room++) {
            occupancy[floor][room] = rand() % 2;

            if (occupancy[floor][room] == 1) {
                occupied++;
            }
        }

        vacant = 10 - occupied;

        cout << "Floor " << floor + 1
             << ": Occupied = " << occupied
             << ", Vacant = " << vacant << endl;
    }

    // 3D ARRAY: THREE HOTEL BRANCHES
    int chain[3][5][10];
    int totalOccupied = 0;

    cout << "\n===== HOTEL CHAIN OCCUPANCY =====\n";

    for (int branch = 0; branch < 3; branch++) {
        int branchOccupied = 0;

        for (int floor = 0; floor < 5; floor++) {
            for (int room = 0; room < 10; room++) {
                chain[branch][floor][room] = rand() % 2;

                if (chain[branch][floor][room] == 1) {
                    branchOccupied++;
                }
            }
        }

        totalOccupied += branchOccupied;

        cout << "Branch " << branch + 1
             << " occupied rooms: " << branchOccupied
             << endl;
    }

    cout << "\nTotal Occupied Rooms Across All Branches: "
         << totalOccupied << endl;

    cout << "Total Rooms Across All Branches: 150" << endl;

    return 0;
}
