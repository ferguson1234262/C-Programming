
#include <iostream>
#include <string>
#include <iomanip>
using namespace std;

string customerName;
double unitsConsumed, totalBill;
double discount, finalAmount;

const double RATE_PER_UNIT = 50.0;

void getCustomerDetails() {
    cout << "Enter customer name: ";
    getline(cin, customerName);

    cout << "Enter units consumed: ";
    cin >> unitsConsumed;
}

void calculateBill() {
    totalBill = unitsConsumed * RATE_PER_UNIT;
}

void applyDiscount() {
    if (unitsConsumed > 100) {
        discount = totalBill * 0.10;
    } else {
        discount = 0;
    }

    finalAmount = totalBill - discount;
}

void displayBill() {
    cout << fixed << setprecision(2);

    cout << "\n========== WATER BILL ==========\n";
    cout << "Customer Name: " << customerName << endl;
    cout << "Units Consumed: " << unitsConsumed << endl;
    cout << "Rate Per Unit: KSh " << RATE_PER_UNIT << endl;
    cout << "Bill Before Discount: KSh " << totalBill << endl;
    cout << "Discount: KSh " << discount << endl;
    cout << "Final Amount Payable: KSh " << finalAmount << endl;
    cout << "================================\n";
}

int main() {
    getCustomerDetails();
    calculateBill();
    applyDiscount();
    displayBill();

    return 0;
}
